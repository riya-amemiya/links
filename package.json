    "@radix-ui/react-slot": "1.5.0",
    "animate.css": "4.1.1",
    "autoprefixer": "10.6.1",
    "chtr": "1.0.0",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "next": "16.4.2",
    "postcss": "8.5.30",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
