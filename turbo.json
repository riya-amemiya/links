{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "outputs": [
                "dist/**"
            ],
            "inputs": [
                "src/**"
            ],
            "env": [
                "NEXT_PUBLIC_*",
                "BASELIME_*"
            ]
        },
        "dev": {
            "persistent": true
        }
    },
    "globalDependencies": [
        "tsconfig.json",
        "jest.config.js",
        ".env.*",
        "yarn.lock"
    ]
}